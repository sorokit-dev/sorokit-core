{
  "name": "@sorokit/core",
  "version": "0.1.0",
  "description": "TypeScript engine and React hooks for building reactive dApps on Stellar Soroban.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@stellar/freighter-api": "^3.0.0",
    "@stellar/stellar-sdk": "^12.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^15.0.0",
    "@types/react": "^18.2.0",
    "jsdom": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  },
  "keywords": [
    "soroban",
    "stellar",
    "react",
    "sdk",
    "dapp",
    "web3"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sorokit-dev/sorokit-core"
  },
  "homepage": "https://github.com/sorokit-dev/sorokit-core#readme",
  "bugs": {
    "url": "https://github.com/sorokit-dev/sorokit-core/issues"
  }
}
